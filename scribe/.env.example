# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Access codes. Set these on any shared or hospital network.
# Doctors type this once per browser (it lasts 12 hours)
SCRIBE_ACCESS_CODE=
# Management code for the demo hospital dashboard
ERP_ACCESS_CODE=

# Speech-to-text. "large-v3-turbo" handles Urdu mixed with English.
# Pure Urdu alternative: kingabzpro/whisper-large-v3-urdu-ct2
SCRIBE_WHISPER_MODEL=large-v3-turbo
SCRIBE_WHISPER_LANGUAGE=ur

# Where approved notes go: fhir | webhook | none.
# Leave SCRIBE_ERP_URL unset to use the demo ERP in docker-compose.
SCRIBE_ERP_MODE=fhir
# SCRIBE_ERP_URL=https://hospital-fhir.example/fhir
# Shared secret between scribe and hospital system (the demo ERP checks it too)
SCRIBE_ERP_TOKEN=

SCRIBE_TIMEZONE=Asia/Karachi
SCRIBE_KEEP_AUDIO=false
